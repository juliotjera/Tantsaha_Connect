# Copier ce fichier en « .env » (même dossier) puis remplir les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).
# Sans fichier .env, l'API fonctionne quand même : base PGlite dans server/.donnees.

PORT=5000

# Base de données : pglite (développement, par défaut) ou postgres (production)
DB_MODE=pglite

# --- Serveur PostgreSQL (DB_MODE=postgres) ---
# Soit une adresse complète fournie par l'hébergeur (Neon, Render…) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/tantsaha_connect?sslmode=require
# Soit les paramètres séparés :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tantsaha_connect
DB_USER=postgres
DB_PASSWORD=
